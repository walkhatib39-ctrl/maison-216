+import type {FastifyInstance} from 'fastify'
+import {prisma} from '../db'
+import {dataOwnerId} from '../auth/scope'
+import {documents,MEDINA,DELPHI,NADHEFNI,allowedByScope} from '../lib/networkPolicy'
+import {mailDir} from '../lib/uploads'
+import fs from 'fs/promises'
+import path from 'path'
+export function registerDirectLeadDocuments(app:FastifyInstance){
+ app.get('/site/:id/lead/:leadId/attachments/:documentId',async(req,reply)=>{
+   reply.header('Cache-Control','private, no-store').header('X-Content-Type-Options','nosniff')
+   const user=await prisma.user.findUnique({where:{id:req.user.sub}});if(!user)return reply.code(403).send({error:'Accès refusé'})
+   const {id,leadId,documentId}=req.params as any
+   const scopes=[user.scopeSiteId,...(Array.isArray(user.scopeSiteIds)?user.scopeSiteIds:[])];if(user.role!=='admin'&&!scopes.includes(id))return reply.code(403).send({error:'Accès non autorisé à ce site'})
+   if(![MEDINA,DELPHI,NADHEFNI].includes(id))return reply.code(404).send({error:'Site introuvable'})
+   const lead=await prisma.lead.findFirst({where:{id:leadId,wpSiteId:id,userId:dataOwnerId(req)}})
+   if(!lead)return reply.code(404).send({error:'Demande introuvable'})
+   if(user.role!=='admin'&&!allowedByScope(lead,user))return reply.code(403).send({error:'Accès non autorisé à cette demande'})
+   const doc=documents(lead).find((d:any)=>d.id===documentId)
+   if(!doc||doc.kind!=='mail')return reply.code(404).send({error:'Document non rattaché à cette demande'})
+   try{
+     const relative=decodeURIComponent(doc.path.slice('/uploads/mail/'.length));if(relative.split('/').includes('..')||relative.includes('\\'))return reply.code(400).send({error:'Chemin invalide'})
+     const root=await fs.realpath(mailDir),file=await fs.realpath(path.resolve(root,relative));if(!file.startsWith(root+path.sep))return reply.code(404).send({error:'Document invalide'})
+     if((await fs.stat(file)).size>25*1024*1024)return reply.code(413).send({error:'Document trop volumineux'})
+     const mime=doc.mime||'application/octet-stream',inline=['image/jpeg','image/png','image/webp','image/gif','application/pdf'].includes(mime)
+     return reply.type(inline?mime:'application/octet-stream').header('Content-Disposition',`${inline?'inline':'attachment'}; filename*=UTF-8''${encodeURIComponent(String(doc.name).replace(/[\r\n\\/]/g,'_'))}`).send(await fs.readFile(file))
+   }catch{return reply.code(404).send({error:'Document indisponible'})}
+ })
+}
