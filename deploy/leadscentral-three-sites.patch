+   add('Photographie professionnelle',/\bphotographes?\b|shooting.{0,15}(?:photo|produit)|photos?\s+(?:professionnel(?:le)?s?|publicitaires?|de produits|produits)|photographie.{0,20}(?:produit|corporate|entreprise|industriel)/)
