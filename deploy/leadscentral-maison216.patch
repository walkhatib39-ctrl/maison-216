+export function isMaisonSite(url: string): boolean {
+  try { return new URL(url).hostname.replace(/^www\./,'').toLowerCase() === 'maison216.tn' } catch { return false }
+}
+export function maisonSourceUpdate(lead: any, existing: any) {
+  const raw=lead.metadata?.raw
+  if (raw?.origin !== 'maison216-v1' || !/^\d+$/.test(lead.external_id)) return null
+  if (raw.source_revision && raw.source_revision===existing.metadata?.raw?.source_revision) return null
+  // Followup, AI notes, identity and receipt date are deliberately outside this update.
+  return { metadata: { ...(existing.metadata || {}), ...lead.metadata }, message:lead.message || null, service:lead.service || null, ville:lead.ville || '' }
+}
