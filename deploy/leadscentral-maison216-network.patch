+export function revision(lead:any) {return createHash('sha256').update(JSON.stringify({name:lead.nom,email:lead.email,phone:lead.telephone,city:lead.ville,message:original(lead),docs:documents(lead),status:lead.metadata?.raw?.status,review:lead.metadata?.raw?.review_status})).digest('hex')}
