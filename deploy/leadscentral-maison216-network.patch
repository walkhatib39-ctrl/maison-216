+   }
+ }
+ add('Cuisine sur mesure',/cuisin(?:e|es)\s+(?:equipe|sur mesure|amenage)|amenagement.{0,25}cuisine|meubles? de cuisine|مطبخ|مطابخ/)
+ add('Dressing et rangement',/dressing|placards?|armoires?|bibliotheques?|etagere|خزانة/)
+ add('Mobilier et agencement',/\bmeubles?\b|\bmobilier\b|\bbanquette|\bcomptoir|\bagencement\b|\bbureau.{0,35}(?:sur mesure|bois|acier)|نجارة|اثاث/)
+ add(/\bbois\b|\bmdf\b/.test(t)?'Menuiserie bois et portes':/\balu|minium/.test(t)?'Menuiserie aluminium':'Menuiserie — matériau à préciser',/menuiserie|menuisier|portes? (?:d.interieur|en bois)|boiserie|نجار/)
