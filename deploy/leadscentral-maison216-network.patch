+export function networkWhatsApp(members:any[]) {
+ const rows=members.filter(m=>m.status==='approved')
+ if(!rows.length)return ''
+ const first=rows[0],briefs=[...new Set(rows.map(m=>m.sharedBrief).filter(Boolean))]
+ const files=[...new Set(rows.flatMap(m=>m.documents.filter((d:any)=>(m.selectedDocuments||[]).includes(d.id)).map((d:any)=>d.name)))]
+ return [
+  'Opportunité pour Maison216',
+  `Lot : ${[...new Set(rows.map(m=>m.lot))].join(' · ')}`,
+  `Client : ${first.name||'À préciser'}`,
+  first.city&&`Lieu : ${first.city}`,first.phone&&`Téléphone : ${first.phone}`,first.email&&`Email : ${first.email}`,
+  '\nBesoin validé :',...briefs,
+  '\nOrigine : '+rows.map(m=>`${m.sourceSite} · réf. ${m.reference}`).join(' / '),
+  files.length?'\nPièces à joindre : '+files.join(', '):'',
+  rows.some(m=>m.sourceAlreadyContacted)?'\nLe client a déjà été contacté côté source : coordonner la relance.':'',
+  '\nMerci de me confirmer si ce projet vous intéresse et qui le prend en charge.'
+ ].filter(Boolean).join('\n')
+}
