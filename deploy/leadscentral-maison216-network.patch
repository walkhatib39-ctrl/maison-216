+ for(const [i,url] of (m.photos||[]).entries()){if(typeof url!=='string'||!url.startsWith('/uploads/mail/')||seen.has(url))continue;seen.add(url);docs.push({id:'p-'+i,name:decodeURIComponent(url.split('/').pop()||'Photo'),mime:/\.png$/i.test(url)?'image/png':/\.webp$/i.test(url)?'image/webp':'image/jpeg',size:0,available:true,kind:'mail',path:url})}
