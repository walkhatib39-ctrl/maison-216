+export function documents(lead:any) {
+ const m=lead.metadata||{},raw=m.raw||{}
+ if(raw.origin==='tunibusiness-v1')return (raw.documents||[]).filter((d:any)=>/^[ai]-\d+(?:-\d+)?$/.test(d.id)).map((d:any)=>({id:d.id,name:d.name,mime:d.mime,size:d.size,available:d.available!==false,kind:'source'}))
+ const docs:any[]=[]; const seen=new Set<string>()
