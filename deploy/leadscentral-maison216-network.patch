+export function qualify(lead:any) {
+ const text=original(lead), t=plain(text),r=lead.metadata?.raw||{}
+ if (/m216-test|test crm|test technique|ne pas traiter|demande test|ceci est un test|test integration|test automatique/.test(t))return null
+ if (/mon compte ou mon entreprise|trouver de nouveaux clients|developper notre activite/.test(plain(r.title)+' '+t))return null
+ if (/proposer.{0,45}collaboration|explorer.{0,45}collaboration|marketing digital|recherche.{0,20}(stage|emploi)|candidature|fiche de notre entreprise/.test(t))return null
