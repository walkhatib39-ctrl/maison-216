+ const ss=Array.isArray(user.scopeServices)?user.scopeServices:[]
+ return !ss.length||ss.includes(lead.service)
+}
+export function maySee(decision:any,lead:any,user:any) {return user.role==='admin'||!!(decision?.status==='approved'&&decision.source_revision===revision(lead)&&allowedByScope(lead,user))}
+export function similar(a:any,b:any) {
+ const phone=(v:any)=>String(v||'').replace(/\D/g,'').replace(/^(?:00216|216)(?=\d{8}$)/,'')
+ const ae=plain(a.email).trim(),be=plain(b.email).trim(),ap=phone(a.telephone),bp=phone(b.telephone)
