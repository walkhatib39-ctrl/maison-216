+export default function ProjectLocationCard({location}:{location:any}){
+ const [copied,setCopied]=useState(false)
+ const l=location||{},missing=!l.city||!l.address
+ useEffect(()=>setCopied(false),[l.city,l.address,l.siteName])
+ const fields=[!l.city?'la ville':null,!l.address?'l’adresse exacte':null].filter(Boolean).join(' et ')
+ const question=`Bonjour, pouvez-vous préciser ${fields} du chantier${l.siteName?' (« '+l.siteName+' »)':''} et, si possible, nous envoyer sa position ? Cela nous permettra d’organiser la visite et de préparer le devis.`
+ return <section aria-label="Lieu du chantier" className={`rounded-xl border p-4 ${missing?'border-amber-200 bg-amber-50/60 dark:border-amber-800 dark:bg-amber-900/10':'border-primary-200 bg-primary-50/60 dark:border-primary-800 dark:bg-primary-900/10'}`}>
+   <div className="flex flex-wrap items-center justify-between gap-2"><h3 className="text-base font-semibold">Lieu du chantier</h3>{missing&&<span className="rounded-full bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-200">À compléter avec le client</span>}</div>
+   {l.siteName&&<p className="mt-2 text-lg font-semibold">{l.siteName}</p>}
+   <dl className="mt-3 grid gap-3 sm:grid-cols-2"><div><dt className="text-xs font-medium uppercase tracking-wide text-slate-500">Ville / secteur</dt><dd className={`mt-1 text-base font-semibold ${!l.city?'text-amber-700 dark:text-amber-300':''}`}>{l.city||'Ville non précisée'}</dd></div><div><dt className="text-xs font-medium uppercase tracking-wide text-slate-500">Adresse du chantier</dt><dd className={`mt-1 break-words font-medium ${!l.address?'text-amber-700 dark:text-amber-300':''}`}>{l.address||'Adresse exacte à demander'}</dd></div></dl>
+   {l.origin&&<p className="mt-2 text-xs text-slate-500">{l.origin}</p>}
+   {missing&&<button type="button" onClick={async()=>{try{await navigator.clipboard.writeText(question);setCopied(true)}catch{setCopied(false)}}} className="mt-3 text-sm font-medium text-primary-700 dark:text-primary-300">{copied?'Question copiée pour le client ✓':'Copier la question pour demander le lieu'}</button>}
+ </section>
