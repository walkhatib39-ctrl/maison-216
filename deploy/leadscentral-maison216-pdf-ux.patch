+import { jsPDF } from 'jspdf'
+import { PDFDocument } from 'pdf-lib'
+export type PackFile={name:string;bytes:Uint8Array;mime:string;references:string[];image?:Uint8Array}
+export type Fonts={normal:string;bold:string}
+const clean=(s:any)=>String(s||'').replace(/\r/g,'').replace(/\\([.*-])/g,'$1').replace(/\*\*([^*]+)\*\*/g,'$1')
+export async function buildNetworkPdf(members:any[],files:PackFile[],fonts:Fonts,zipMode=false){
+ if(!members.length||members.some(m=>m.status!=='approved'))throw Error('Une validation est nécessaire avant de créer la fiche.')
+ const attachments:({file:PackFile;pdf?:PDFDocument;kind:'PDF'|'Photo'|'Original dans le ZIP'})[]=[]
+ let totalPages=0
+ for(const f of files){
+   if(f.mime==='application/pdf'||/\.pdf$/i.test(f.name)){
+     try{const pdf=await PDFDocument.load(f.bytes);if(pdf.isEncrypted)throw Error('encrypted');totalPages+=pdf.getPageCount()+1;attachments.push({file:f,pdf,kind:'PDF'})}
+     catch{if(!zipMode)throw Error(`Le PDF « ${f.name} » ne peut pas être fusionné. Choisissez « PDF + originaux (ZIP) » pour conserver le fichier original.`);attachments.push({file:f,kind:'Original dans le ZIP'})}
+   }else if(f.image){attachments.push({file:f,kind:'Photo'});totalPages++}
+   else {if(!zipMode)throw Error(`Le fichier « ${f.name} » nécessite le dossier « PDF + originaux (ZIP) » pour être transmis intégralement.`);attachments.push({file:f,kind:'Original dans le ZIP'})}
+ }
+ if(totalPages>200)throw Error('Les annexes dépassent 200 pages. Sélectionnez moins de documents pour ce dossier.')
+ const make=()=>{const d=new jsPDF({unit:'mm',format:'a4',compress:true});d.addFileToVFS('Network-Regular.ttf',fonts.normal);d.addFont('Network-Regular.ttf','Network','normal');d.addFileToVFS('Network-Bold.ttf',fonts.bold);d.addFont('Network-Bold.ttf','Network','bold');d.setFont('Network');return d}
+ const d=make();let y=43
+ const header=()=>{d.setFillColor(15,33,56);d.rect(0,0,210,30,'F');d.setTextColor(255);d.setFont('Network','bold');d.setFontSize(18);d.text('MAISON216',17,14);d.setFont('Network','normal');d.setFontSize(9);d.text('FICHE DE BESOIN - OPPORTUNITÉ DU RÉSEAU',17,23);d.setTextColor(28,42,61)}
+ const page=()=>{d.addPage();header();y=43}
+ const line=(v:any,size=10,bold=false)=>{
+   d.setFont('Network',bold?'bold':'normal');d.setFontSize(size)
+   const lines=d.splitTextToSize(clean(v),176)
+   for(const text of lines){if(y>274)page();d.setFont('Network',bold?'bold':'normal');d.setFontSize(size);const rtl=/[\u0600-\u06ff]/.test(text);d.setR2L(false);d.text(text,rtl?193:17,y,{align:rtl?'right':'left'});d.setR2L(false);y+=size*0.47+1.5}
+ }
+ const section=(title:string)=>{if(y>255)page();y+=5;d.setDrawColor(209,222,232);d.line(17,y-3,193,y-3);d.setTextColor(0,106,156);line(title,12,true);d.setTextColor(28,42,61);y+=2}
+ header();line([...new Set(members.map(m=>m.lot))].join(' · '),15,true);line('Préparée le '+new Date().toLocaleDateString('fr-FR'),8);y+=3
