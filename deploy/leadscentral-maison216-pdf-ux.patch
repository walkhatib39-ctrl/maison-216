+import {apiClient} from './apiClient'
+import {buildNetworkPdf,type PackFile} from './networkPdfCore'
+import normalUrl from 'dejavu-fonts-ttf/ttf/DejaVuSans.ttf?url'
+import boldUrl from 'dejavu-fonts-ttf/ttf/DejaVuSans-Bold.ttf?url'
+const base='/dashboard/site/b4a9bcd7-8813-4206-aa2c-525e3d525b9c/network-opportunities'
+const b64=(data:ArrayBuffer)=>{let s='';const bytes=new Uint8Array(data);for(let i=0;i<bytes.length;i+=8192)s+=String.fromCharCode(...bytes.subarray(i,i+8192));return btoa(s)}
+const snapshot=(ms:any[])=>JSON.stringify(ms.map(m=>[m.id,m.revision,m.sharedBrief,m.lot,m.name,m.phone,m.email,m.city,m.documents,m.selectedDocuments]))
+async function jpeg(bytes:Uint8Array,mime:string){
+ const url=URL.createObjectURL(new Blob([bytes as BlobPart],{type:mime}));try{const img=new Image();img.src=url;await img.decode();if(!img.naturalWidth||img.naturalWidth*img.naturalHeight>80000000)throw Error('Image trop grande');const scale=Math.min(1,2400/Math.max(img.naturalWidth,img.naturalHeight));const c=document.createElement('canvas');c.width=Math.round(img.naturalWidth*scale);c.height=Math.round(img.naturalHeight*scale);const ctx=c.getContext('2d')!;ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);ctx.drawImage(img,0,0,c.width,c.height);const blob=await new Promise<Blob>((resolve,reject)=>c.toBlob(b=>b?resolve(b):reject(Error('Image illisible')),'image/jpeg',0.9));return new Uint8Array(await blob.arrayBuffer())}finally{URL.revokeObjectURL(url)}
+}
+export async function downloadNetworkPack(selected:any[],mode:'pdf'|'zip',progress:(s:string)=>void){
+ progress('Vérification de la validation…')
+ const items=selected.map(m=>({id:m.id,revision:m.revision}))
+ const {data}=await apiClient.post(base+'/export',{items});const members=data.members
+ const manifest=members.flatMap((m:any)=>m.documents.map((d:any)=>({member:m,doc:d})))
+ if(manifest.length>50)throw Error('Sélectionnez au maximum 50 pièces pour un dossier.')
+ const files:PackFile[]=[],hashes=new Map<string,PackFile>();let size=0
+ for(const [i,{member,doc}] of manifest.entries()){
+   progress(`Récupération des pièces ${i+1}/${manifest.length}…`)
+   if(doc.available===false)throw Error(`Le fichier « ${doc.name} » est indisponible. Aucun dossier incomplet n’a été téléchargé.`)
+   let r;try{r=await apiClient.get(`${base}/${member.id}/documents/${encodeURIComponent(doc.id)}`,{responseType:'arraybuffer'})}catch{throw Error(`Impossible de récupérer « ${doc.name} ». Réessayez ; aucun fichier n’a été omis silencieusement.`)}
+   const bytes=new Uint8Array(r.data);size+=bytes.length;if(size>100*1024*1024)throw Error('Les pièces dépassent 100 Mo. Réduisez la sélection.')
+   const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))).map(b=>b.toString(16).padStart(2,'0')).join('');const ref=member.sourceSite+' - '+member.reference
+   if(hashes.has(digest)){hashes.get(digest)!.references.push(ref);continue}
+   const mime=(r.headers['content-type']||doc.mime||'application/octet-stream').split(';')[0];const f:PackFile={name:doc.name,bytes,mime,references:[ref]}
+   if(mime.startsWith('image/')&&!mime.includes('svg')){try{f.image=await jpeg(bytes,mime)}catch{if(mode==='pdf')throw Error(`La photo « ${doc.name} » ne peut pas être convertie. Utilisez le dossier ZIP pour transmettre l’original.`)}}
+   files.push(f);hashes.set(digest,f)
+ }
+ progress('Création de la fiche et des annexes…')
+ const fonts=await Promise.all([normalUrl,boldUrl].map(async url=>{const r=await fetch(url);if(!r.ok)throw Error('Police de caractères indisponible');return b64(await r.arrayBuffer())}))
+ const pdf=await buildNetworkPdf(members,files,{normal:fonts[0],bold:fonts[1]},mode==='zip')
+ const check=await apiClient.post(base+'/export',{items});if(snapshot(check.data.members)!==snapshot(members))throw Error('La validation ou le dossier a changé pendant la création. Actualisez puis recommencez.')
+ const name='Maison216-'+String(members[0].name||'projet').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9_-]+/g,'-').slice(0,60)
+ let output:Blob
+ if(mode==='zip'){
+   const {default:JSZip}=await import('jszip');const zip=new JSZip();zip.file(name+'.pdf',pdf)
+   files.forEach((f,i)=>zip.file(`Originaux/${String(i+1).padStart(2,'0')}-${f.name.replace(/[\x00-\x1f\\/:*?"<>|]/g,'_').slice(0,160)}`,f.bytes))
+   zip.file('Lire-moi.txt','La fiche PDF contient le besoin validé et les annexes lisibles. Le dossier Originaux conserve toutes les pièces sélectionnées, notamment DWG, tableurs et PDF protégés. Aucun envoi WhatsApp automatique.');output=await zip.generateAsync({type:'blob',compression:'DEFLATE'})
+ }else output=new Blob([pdf as BlobPart],{type:'application/pdf'})
+ const url=URL.createObjectURL(output);const link=document.createElement('a');link.href=url;link.download=name+(mode==='zip'?'.zip':'.pdf');link.click();setTimeout(()=>URL.revokeObjectURL(url),30000)
+ return {files:files.length,name:link.download}
+}
