+import type {FastifyInstance,FastifyRequest,FastifyReply} from 'fastify'
+import {prisma} from '../db'
+import {dataOwnerId} from '../auth/scope'
+import {DESTINATIONS} from '../lib/networkPolicy'
+import {cleanBrief,inspirationEligibility,sourceHash,hash,imagePrompt} from '../lib/inspirationPolicy'
+import {randomUUID} from 'crypto'
+import fs from 'fs/promises'
+import path from 'path'
+import sharp from 'sharp'
+import {z} from 'zod'
+const MODEL='gpt-image-2.5-flare'
+const dir=path.resolve(__dirname,'../../private/inspirations')
+const font=path.resolve(__dirname,'../../../client/node_modules/dejavu-fonts-ttf/ttf/DejaVuSans.ttf')
+const ownerLocks=new Set<string>()
+async function context(req:FastifyRequest,reply:FastifyReply,destination?:string){
+ reply.header('Cache-Control','private, no-store').header('X-Content-Type-Options','nosniff')
+ const user=await prisma.user.findUnique({where:{id:req.user.sub}})
+ if(user?.role!=='admin'){reply.code(403).send({error:'Génération et suivi réservés à l’administrateur'});return null}
+ const {id,leadId}=req.params as any,owner=dataOwnerId(req),dest=destination||id,cfg=DESTINATIONS[dest]
+ if(!cfg||!(dest===id||cfg.sources.includes(id))){reply.code(404).send({error:'Projet non disponible'});return null}
+ const target=await prisma.wpSite.findFirst({where:{id:dest,userId:owner}}),lead=await prisma.lead.findFirst({where:{id:leadId,wpSiteId:id,userId:owner}})
+ if(!target||!lead){reply.code(404).send({error:'Projet introuvable'});return null}
+ return {lead,owner,dest,brand:cfg.name,user}
+}
+async function rows(lead:string,dest:string){return prisma.$queryRaw<any[]>`SELECT * FROM lead_inspirations WHERE lead_id=${lead} AND destination_id=${dest} ORDER BY created_at DESC LIMIT 12`}
+const safe=(r:any,current:string)=>({id:r.id,status:r.status,brief:r.brief,adjustments:r.adjustments,error:r.error_code,clientState:r.client_state,clientNote:r.client_note||'',createdAt:r.created_at,stale:r.source_hash!==current,model:r.model})
+export async function stampImage(bytes:Buffer){
+ const photo=await sharp(bytes,{limitInputPixels:50000000}).rotate().resize({width:1536,withoutEnlargement:true}).png().toBuffer()
+ const m=await sharp(photo).metadata(),w=m.width!,h=m.height!,footer=Math.max(96,Math.round(w/12))
+ const text=await sharp({text:{text:'INSPIRATION GÉNÉRÉE - À VALIDER\nStyle indicatif - Dimensions et fabrication à confirmer',fontfile:font,font:'DejaVu Sans',width:w-80,height:footer-30,align:'center',rgba:true}}).png().toBuffer()
+ const tm=await sharp(text).metadata()
+ return sharp(photo).extend({bottom:footer,background:'#f4f2ed'}).composite([{input:text,left:Math.round((w-tm.width!)/2),top:h+Math.round((footer-tm.height!)/2)}]).png().toBuffer()
+}
+async function generate(id:string,apiKey:string,prompt:string){
+ try{
+   const response=await fetch('https://api.openai.com/v1/images/generations',{method:'POST',headers:{Authorization:'Bearer '+apiKey,'Content-Type':'application/json'},body:JSON.stringify({model:MODEL,prompt,n:1,size:'1536x1024',quality:'medium',output_format:'png'}),signal:AbortSignal.timeout(240000)})
+   const result:any=await response.json()
+   if(!response.ok){const code=result?.error?.code;throw Error(code==='insufficient_quota'?'quota':response.status===401?'key':response.status===403?'access':response.status===429?'rate':'generation')}
+   const encoded=result.data?.[0]?.b64_json;if(typeof encoded!=='string'||encoded.length>40*1024*1024)throw Error('generation')
+   const image=await stampImage(Buffer.from(encoded,'base64'));await fs.mkdir(dir,{recursive:true,mode:0o700});await fs.writeFile(path.join(dir,id+'.png'),image,{mode:0o600})
+   await prisma.$executeRaw`UPDATE lead_inspirations SET status='ready',error_code=NULL,updated_at=CURRENT_TIMESTAMP(3) WHERE id=${id}`
+ }catch(e:any){const code=['quota','key','access','rate','generation'].includes(e.message)?e.message:'interrupted';await prisma.$executeRaw`UPDATE lead_inspirations SET status='failed',error_code=${code},updated_at=CURRENT_TIMESTAMP(3) WHERE id=${id}`}
+}
+export function registerLeadInspirations(app:FastifyInstance){
+ const prefix='/site/:id/lead/:leadId/inspirations'
+ app.get(prefix,async(req,reply)=>{
